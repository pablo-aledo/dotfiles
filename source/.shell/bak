[ -e ~/backup ] && BAK_FOLDER=~/backup
[ -e /media/DATA/backup ] && BAK_FOLDER=/media/DATA/backup

sbak(){
	name="$1"
	[ -e "$name" ] || shift
	sudo tar -cvzf "$name".backup.`date +%y%m%d-%H%M%S`.tgz $*
}

bak(){
	name="$1"
	[ $name = "default" ] && name=$BAK_FOLDER/$(basename $2)
	[ -e "$name" ] || shift
	tar -cvzf "$name".backup.`date +%y%m%d-%H%M%S`.tgz $*
}

bak_long(){
    local name="$1"
    [ "$name" = "default" ] && name="$BAK_FOLDER/$(basename "$2")"
    if [ -e "$name" ]; then
        :   # el primer argumento es también un archivo a incluir
    else
        shift
    fi
    local out="$name.backup.$(date +%y%m%d-%H%M%S).tgz"

    # Si queda un solo argumento con comodín (entre comillas), usar find
    if [ $# -eq 1 ] && [[ "$1" == *[\*\?]* ]]; then
        find . -maxdepth 1 -name "$1" -print0 | tar -cvzf "$out" --null -T -
    else
        tar -cvzf "$out" "$@"
    fi
}

mergebak(){
	last=`ls $* | sort | tail -n1`
	lastname=`ls $* | sort | tail -n1 | sed 's/\.backup\..*//g'`

	mkdir /tmp/$last
	cd /tmp/$last
	tar -xzf $OLDPWD/$last
	cd -

	for a in $*
	do 
		[ $a = $last ] && break
		mkdir /tmp/$a
		cd /tmp/$a
		tar -xzf $OLDPWD/$a
		meld /tmp/$a /tmp/$last
		cd -
	done

	cd /tmp/$last
	tar -czf $OLDPWD/${lastname%.*}.backup.`date +%y%m%d-%H%M%S`.tgz *
	cd -
}

