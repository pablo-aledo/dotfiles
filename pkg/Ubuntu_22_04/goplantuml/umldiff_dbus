umldiff(){
    local review_leaf review_base
    review_leaf=$(Git rev-parse HEAD)
    review_base=$(Git branch_base)

    \git checkout .; \git checkout "$review_base"; dbus_uml . /tmp/dbusdiff_main.plantuml
    \git checkout .; \git checkout "$review_leaf"; dbus_uml . /tmp/dbusdiff_branch.plantuml
    [ "$(\git rev-parse $(Git branch_current))" = "$(\git rev-parse HEAD)" ] && \
        \git checkout $(Git branch_current)

    # Resumen "interfaz/metodo" para comparar
    awk '/^interface/{iface=$2; gsub(/"/,"",iface)}
         /^[[:space:]]*\+/{print iface "/" $0}' /tmp/dbusdiff_main.plantuml \
         | sort -u > /tmp/dbusdiff_main.summary
    awk '/^interface/{iface=$2; gsub(/"/,"",iface)}
         /^[[:space:]]*\+/{print iface "/" $0}' /tmp/dbusdiff_branch.plantuml \
         | sort -u > /tmp/dbusdiff_branch.summary

    # Añadidos (verde) y eliminados (rojo)
    comm -13 /tmp/dbusdiff_main.summary /tmp/dbusdiff_branch.summary \
      | awk -F'/' '{gsub(/^[[:space:]]*\+/,"",$2);
                    print "class \""$1"\" #Ivory {\n<b><color: green>+"$2"</color></b>\n}"}' \
      > /tmp/dbus_diff
    comm -23 /tmp/dbusdiff_main.summary /tmp/dbusdiff_branch.summary \
      | awk -F'/' '{gsub(/^[[:space:]]*\+/,"",$2);
                    print "class \""$1"\" #Ivory {\n<b><color: red>+"$2"</color></b>\n}"}' \
      >> /tmp/dbus_diff

    sed '$ d' /tmp/dbusdiff_branch.plantuml > ~/tmp/dbusdiff.plantuml
    cat /tmp/dbus_diff  >> ~/tmp/dbusdiff.plantuml
    echo '@enduml'      >> ~/tmp/dbusdiff.plantuml

    (
        cd /tmp/
        docker_app plantuml -tsvg dbusdiff.plantuml
        google-chrome dbusdiff.svg
    )
}

dbus_uml () {
    local search_dir="${1:-.}"
    local output="${2:-dbus_interfaces.puml}"
    local tmp_out="${output}.tmp"

    {
    echo "@startuml"
    echo "set separator none"
    echo "skinparam classAttributeIconSize 0"
    echo "hide empty members"
    echo ""
    } > "$tmp_out"

    grep --color -rl -E 'interface[[:space:]]*\([[:space:]]*name[[:space:]]*=' --include='*.rs' "$search_dir" 2> /dev/null | sort | while IFS= read -r file
    do
        [ -z "$file" ] && continue
        awk '
        function count_char(s, ch,   i, n) {
            n = 0
            for (i = 1; i <= length(s); i++)
                if (substr(s, i, 1) == ch) n++
            return n
        }
        function flush() {
            if (iface != "" && body != "") {
                printf "interface \"%s\" {\n", iface
                printf "%s", body
                printf "}\n\n"
            }
            iface = ""; body = ""
            active = 0; in_body = 0; depth = 0; opened = 0; is_prop = 0
        }

        # --- 1) Atributos ---------------------------------------------
        /^[[:space:]]*#\[/ {
            if (active == 0) {
                # Acepta #[interface(name = "...")] y #[zbus::interface(name = "...")]
                if (match($0, /interface[ \t]*\([ \t]*name[ \t]*=[ \t]*"[^"]*"/)) {
                    s = substr($0, RSTART, RLENGTH)
                    if (match(s, /"[^"]*"/))
                        iface = substr(s, RSTART + 1, RLENGTH - 2)
                    body = ""; active = 1; in_body = 0
                    depth = 0; opened = 0; is_prop = 0
                }
                next
            }
            # Dentro del impl: ¿es #[zbus(property)]?
            if ($0 ~ /#\[zbus[ \t]*\([ \t]*property[ \t]*\)\]/) is_prop = 1
            next
        }

        # --- 2) Entrada al impl ---------------------------------------
        active && !in_body && /^[[:space:]]*impl[[:space:]<]/ {
            in_body = 1
        }

        # --- 3) Cuerpo del impl ---------------------------------------
        in_body {
            # Declaración de fn a nivel 1: exige "fn <id> ... ("
            if (depth == 1 && match($0, \
                /(^|[^A-Za-z0-9_])fn[ \t]+[A-Za-z_][A-Za-z0-9_]*([ \t]*<[^>]*>)?[ \t]*\(/)) {
                s = substr($0, RSTART, RLENGTH)
                sub(/^[^A-Za-z0-9_]+/, "", s)   # separador previo
                sub(/^fn[ \t]+/, "", s)         # "fn "
                sub(/[^A-Za-z0-9_].*$/, "", s)  # "(...)" y lo que siga
                if (s != "") {
                    if (is_prop) body = body "  + " s "\n"      # property
                    else         body = body "  + " s "()\n"    # método
                }
                is_prop = 0
            }
            depth += count_char($0, "{") - count_char($0, "}")
            if (depth > 0) opened = 1
            if (opened && depth <= 0) flush()
        }
        ' "$file"
    #done >> "$tmp_out"
	done | awk '
        /^interface "/ {
            name = $0
            sub(/^interface "/, "", name)
            sub(/" \{$/, "", name)
            if (!(name in seen)) { seen[name] = 1; order[++n] = name }
            cur = name
            next
        }
        /^}/ { cur = ""; next }
        cur != "" && /^  \+/ {
            key = cur SUBSEP $0
            if (!(key in have)) {
                have[key] = 1
                body[cur] = body[cur] $0 "\n"
            }
            next
        }
        END {
            for (i = 1; i <= n; i++)
                printf "interface \"%s\" {\n%s}\n\n", order[i], body[order[i]]
        }
    ' >> "$tmp_out"

    echo "@enduml" >> "$tmp_out"
    \mv "$tmp_out" "$output"
    echo "Diagrama D-Bus generado en: $output"
}

uml_show(){
    dbus_uml . ~/tmp/dbus.plantuml
    (
        cd ~/tmp/
        docker_app plantuml -tsvg dbus.plantuml
        google-chrome dbus.svg
    )
}
